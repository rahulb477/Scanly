DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: public URL used to build absolute business URLs in the QR.
# If unset, the app falls back to the deployment's VERCEL_URL or http://localhost:3000.
NEXT_PUBLIC_APP_URL=https://your-domain.example.com

# Optional: AI provider for review generation.
# Currently the app uses a deterministic in-process generator so it works without any key.
# You can add your own provider by extending src/lib/ai-review.ts.
AI_PROVIDER=local
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=