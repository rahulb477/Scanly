# Firebase Web App configuration (public client configuration, not Admin secrets).
# Replace these placeholders with values from your own Firebase Web App.
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Optional Google UI. Leave false unless the Google provider is enabled.
NEXT_PUBLIC_FIREBASE_GOOGLE_ENABLED=false

# Set to your actual HTTPS production origin before printing QR codes.
# Leave blank locally to use the current request/browser origin.
NEXT_PUBLIC_APP_URL=

# SERVER ONLY. Use a newly issued key after revoking any exposed key.
FIREBASE_PROJECT_ID=your-project-id
# Paste the service account's client_email, NOT a personal Gmail address.
FIREBASE_CLIENT_EMAIL=
# Paste only the PEM private_key string, NOT an entire service-account JSON object.
# Use a quoted string with escaped newlines in .env.local; actual newlines also work on Vercel.
FIREBASE_PRIVATE_KEY=
# Alternative on Google-hosted runtimes or configured local ADC:
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=false
# Keep true when Storage is provisioned; deletes business images during owner deletion.
FIREBASE_CLEANUP_STORAGE_ON_DELETE=true

# Existing provider-free review drafting algorithm (no external LLM key required).
AI_PROVIDER=local

# Emulators: test tooling supplies a demo- project and all hosts automatically.
# NEVER enable emulator mode or emulator host variables in Vercel production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# OPTIONAL: legacy data export/migration ONLY. Not used by login or the application.
# DATABASE_URL=
