rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function business(id) { return get(/databases/$(database)/documents/businesses/$(id)).data; }
    function owner(id) { return signedIn() && business(id).ownerId == request.auth.uid; }
    function member(id) {
      return signedIn() && (owner(id) ||
        (exists(/databases/$(database)/documents/businesses/$(id)/members/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/businesses/$(id)/members/$(request.auth.uid)).data.uid == request.auth.uid &&
         get(/databases/$(database)/documents/businesses/$(id)/members/$(request.auth.uid)).data.businessId == id &&
         get(/databases/$(database)/documents/businesses/$(id)/members/$(request.auth.uid)).data.role in ['admin', 'staff']));
    }
    function manager(id) {
      return owner(id) || (member(id) && get(/databases/$(database)/documents/businesses/$(id)/members/$(request.auth.uid)).data.role == 'admin');
    }
    function active(id) { return !('deleting' in business(id)) || business(id).deleting == false; }
    function published(id) { return business(id).isPublished == true && active(id); }
    function publicMenu(id) { return published(id) && business(id).menuEnabled == true; }
    function timestampsOnCreate() { return request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time; }
    function timestampsOnUpdate() { return request.resource.data.createdAt == resource.data.createdAt && request.resource.data.updatedAt == request.time; }
    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['uid', 'name', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt']) &&
        d.uid == uid && d.role == 'user' && d.name is string && d.name.size() <= 200 &&
        d.email is string && d.email == request.auth.token.email &&
        (d.photoURL == null || (d.photoURL is string && d.photoURL.size() <= 2048));
    }
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validProfile(uid) && timestampsOnCreate();
      allow update: if signedIn() && request.auth.uid == uid && validProfile(uid) && timestampsOnUpdate();
      // Account deletion must be coordinated with Firebase Auth/ownership server-side.
      allow delete: if false;
    }
    match /businesses/{id} {
      allow read: if member(id);
      // All mutations use the token-verified API so publication, immutable identity,
      // slug reservations, settings and the public projection stay consistent.
      allow write: if false;

      match /members/{uid} {
        allow read: if member(id);
        allow create, update: if owner(id) && uid != business(id).ownerId &&
          request.resource.data.keys().hasOnly(['uid', 'businessId', 'role', 'createdAt', 'updatedAt']) &&
          request.resource.data.uid == uid && request.resource.data.businessId == id &&
          request.resource.data.role in ['admin', 'staff'] &&
          ((resource == null && timestampsOnCreate()) || (resource != null && timestampsOnUpdate()));
        allow delete: if owner(id) && uid != business(id).ownerId;
      }
      match /menuCategories/{categoryId} {
        allow read: if member(id) || publicMenu(id);
        // CRUD uses the API to keep category cascades/counters consistent.
        allow write: if false;
      }
      match /menuItems/{itemId} {
        allow read: if member(id) || (publicMenu(id) && resource.data.available == true);
        // Counters, category references/cascades and ordering are coordinated by the API.
        allow write: if false;
      }
      match /wifiSettings/{settingId} {
        allow read: if member(id);
        allow write: if false; // Consent + credentials + public projection are updated by the API together.
      }
      match /reviewSettings/{settingId} {
        allow read: if member(id);
        allow write: if false;
      }
      match /socialLinks/{socialId} {
        allow read: if member(id);
        allow write: if false;
      }
      match /themes/{themeId} {
        allow read: if member(id);
        allow write: if false;
      }
      match /qrCodes/{qrId} {
        allow read: if member(id);
        allow write: if false; // Slug/QR target are immutable, created server-side.
      }
      match /analytics/{eventId} { allow read: if member(id); allow write: if false; }
      match /activityLogs/{logId} { allow read: if member(id); allow write: if false; }
      match /reviewSessions/{sessionId} { allow read: if manager(id); allow write: if false; }
    }
    match /publicBusinesses/{slug} {
      // No listing/scraping, no private fields, no client publishing authority.
      allow get: if published(resource.data.businessId) && resource.data.slug == slug &&
        resource.data.keys().hasOnly(['id', 'businessId', 'businessName', 'slug', 'logo', 'coverImage', 'category', 'description', 'phone', 'email', 'address', 'city', 'state', 'pincode', 'googleMapsUrl', 'menuEnabled', 'isPublished', 'googleReviewUrl', 'googlePlaceId', 'reviewEnabled', 'aiReviewEnabled', 'websiteUrl', 'instagramUrl', 'facebookUrl', 'youtubeUrl', 'whatsappUrl', 'twitterUrl', 'theme', 'primaryColor', 'secondaryColor', 'backgroundColor', 'font', 'tagline', 'cardStyle', 'buttonStyle', 'wifiEnabled', 'wifiName', 'wifiSecurity']);
      allow list, write: if false;
    }
    // Includes businessSlugs, _meta counters, rate limits, legacy top-level names
    // and anything newly added: no permissive fallback.
    match /{document=**} { allow read, write: if false; }
  }
}
